{
  "name": "food-digester-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run && pnpm test:contracts && pnpm test:scripts",
    "test:contracts": "pnpm --filter @fdp/contracts test",
    "test:scripts": "node --import tsx --test scripts/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:evidence": "node scripts/check-eng-db-dom-evidence.mjs",
    "check:aws-iot-evidence": "node scripts/check-aws-iot-data-path-evidence.mjs",
    "check:aws-data-processing-evidence": "node scripts/check-aws-data-processing-evidence.mjs",
    "check:aws-admin-evidence": "node scripts/check-aws-admin-cus-dev-evidence.mjs",
    "check:aws-admin-business-evidence": "node scripts/check-aws-admin-business-evidence.mjs",
    "check:aws-med-rbac-aud-dash-set-evidence": "node scripts/check-aws-med-rbac-aud-dash-set-evidence.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:sensitive-sinks": "node scripts/check-sensitive-sinks.mjs",
    "check:admin-web-delivery": "node scripts/check-admin-web-delivery.mjs",
    "check:admin-web-e2e": "pnpm --filter @fdp/admin-web test:e2e",
    "check:admin-web-target-evidence": "node scripts/check-admin-web-target-evidence.mjs",
    "check:admin-web-fe11-15-target-evidence": "node scripts/check-admin-web-fe11-15-target-evidence.mjs",
    "check:admin-web-fe16-19-target-evidence": "node scripts/check-admin-web-fe16-19-target-evidence.mjs",
    "check:runtime": "node --import tsx scripts/check-delivered-runtime.mjs",
    "check:cdk": "node scripts/check-cdk-synth.mjs",
    "check:cmd-ota-delivery": "pnpm check:runtime && pnpm check:cdk",
    "test:aws-iot-authz": "node --import tsx scripts/verify-aws-iot-authorization.mjs",
    "openapi:bundle": "node scripts/build-openapi.mjs",
    "openapi:check": "node scripts/build-openapi.mjs --check && redocly lint contracts/rest/openapi-base.json \"contracts/rest/*-api.json\" contracts/rest/openapi.bundle.json --extends spec",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm openapi:check && pnpm test && pnpm build && pnpm check:boundaries && pnpm check:schemas && pnpm check:migrations && pnpm check:evidence && pnpm check:secrets && pnpm check:sensitive-sinks && pnpm check:admin-web-delivery && pnpm check:admin-web-e2e && pnpm check:cmd-ota-delivery && pnpm test:device-contracts /tmp/fdp-device-contracts-gate.json",
    "qa:simulator": "node --import tsx scripts/run-device-simulator.mjs",
    "test:simulator": "node --import tsx --test scripts/device-simulator*.test.mjs",
    "test:device-contracts": "node --import tsx scripts/run-contract-suite.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@redocly/cli": "2.51.1",
    "@types/node": "^24.12.0",
    "ajv": "8.20.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.35.0",
    "jsdom": "^27.4.0",
    "mqtt": "5.14.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.11"
  }
}
