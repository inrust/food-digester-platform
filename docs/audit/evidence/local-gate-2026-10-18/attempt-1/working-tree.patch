+    rawClock: { startTime, endTime },
+    clockMapping: {
+      scope: 'V8_TO_HRTIME_BOUNDED_CONSTANT_OFFSET',
+      lowerOffsetUs,
+      upperOffsetUs,
+      uncertaintyUs: Math.max(100, (upperOffsetUs - lowerOffsetUs) / 2),
+    },
+    startTime: startTime + offsetUs,
+    endTime: endTime + offsetUs,
+  };
