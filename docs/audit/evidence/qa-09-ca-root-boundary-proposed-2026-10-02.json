{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowFDPServiceRuntimeActions",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "ec2:CreateNetworkInterface",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DeleteNetworkInterface",
        "ec2:AssignPrivateIpAddresses",
        "ec2:UnassignPrivateIpAddresses",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey*",
        "kms:DescribeKey",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "sqs:*",
        "iot:DescribeEndpoint",
        "iot:Publish",
        "iot:CreateThing",
        "iot:RegisterCertificateWithoutCA",
        "iot:CreatePolicy",
        "iot:AttachPolicy",
        "iot:AttachThingPrincipal",
        "iot:UpdateCertificate",
        "iot:TagResource",
        "cognito-idp:*",
        "events:PutEvents",
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyHumanCredentialAndBoundaryMutation",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary",
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TemporaryQA09ExactWorkerCaRootWrite",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecretVersionStage"
      ],
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:065986019555:secret:fdp-test-device-ca-mecYC7",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-03T00:00:00Z"
        },
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::065986019555:role/fdp-test-onboarding-provisioning-role"
        }
      }
    }
  ]
}
