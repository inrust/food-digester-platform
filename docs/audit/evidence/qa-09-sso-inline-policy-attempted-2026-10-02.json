{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCreateAndManageOnlyFDPProjectRolesWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:UpdateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:ListRoles",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:PutRolePermissionsBoundary",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:ListPolicyVersions",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::065986019555:role/fdp-*",
        "arn:aws:iam::065986019555:policy/fdp-*"
      ],
      "Condition": {
        "StringEqualsIfExists": {
          "iam:PermissionsBoundary": "arn:aws:iam::065986019555:policy/FDP-PermissionsBoundary"
        }
      }
    },
    {
      "Sid": "ReadOwnSSOProvisionedRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::065986019555:role/aws-reserved/sso.amazonaws.com/ap-southeast-1/AWSReservedSSO_FDP-InfraSetup_*"
    },
    {
      "Sid": "AllowPassOnlyFDPProjectRolesToApprovedServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::065986019555:role/fdp-*",
      "Condition": {
        "StringEqualsIfExists": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "iot.amazonaws.com",
            "scheduler.amazonaws.com",
            "events.amazonaws.com",
            "cloudformation.amazonaws.com",
            "amplify.amazonaws.com",
            "rds.amazonaws.com",
            "apigateway.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "TemporaryPassMigrationRunnerRoleToCodeBuildOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::065986019555:role/fdp-test-migration-runner-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "codebuild.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowCreateServiceLinkedRolesOnlyForRequiredAWSService",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "iam:AWSServiceName": [
            "rds.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "ecs.amazonaws.com",
            "autoscaling.amazonaws.com",
            "apigateway.amazonaws.com",
            "iot.amazonaws.com",
            "events.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyBillingPaymentAndAccountOwnership",
      "Effect": "Deny",
      "Action": [
        "account:*",
        "organizations:*",
        "billing:*",
        "payments:*",
        "purchase-orders:*",
        "tax:*",
        "aws-portal:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySecurityAuditTampering",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail",
        "cloudtrail:UpdateTrail",
        "logs:DeleteLogGroup",
        "logs:DeleteLogStream",
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey",
        "kms:PutKeyPolicy",
        "secretsmanager:GetSecretValue",
        "iam:CreateUser",
        "iam:DeleteUser",
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:DeleteAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:DeleteLoginProfile"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageExactFDPBootstrapPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::065986019555:policy/FDP-ServiceBoundary",
        "arn:aws:iam::065986019555:policy/FDP-DeploymentBoundary",
        "arn:aws:iam::065986019555:policy/FDP-CloudFormationExecutionPolicy"
      ]
    },
    {
      "Sid": "ManageExactFDPBootstrapRolesWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:UpdateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": [
        "arn:aws:iam::065986019555:role/fdp-test-cdk-deploy-role",
        "arn:aws:iam::065986019555:role/fdp-test-cloudformation-execution-role",
        "arn:aws:iam::065986019555:role/fdp-test-cdk-file-publishing-role",
        "arn:aws:iam::065986019555:role/fdp-test-cdk-image-publishing-role",
        "arn:aws:iam::065986019555:role/fdp-test-cdk-lookup-role"
      ],
      "Condition": {
        "StringEqualsIfExists": {
          "iam:PermissionsBoundary": "arn:aws:iam::065986019555:policy/FDP-DeploymentBoundary"
        }
      }
    },
    {
      "Sid": "PassExactFDPCloudFormationExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::065986019555:role/fdp-test-cloudformation-execution-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "TemporaryQA09ManageExactProvisioningWorker",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::065986019555:role/fdp-test-onboarding-provisioning-role",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::065986019555:policy/FDP-ServiceBoundary"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-03T00:00:00Z"
        }
      }
    }
  ]
}
