{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cmd.schema.json",
  "title": "Command",
  "x-typescript-name": "Command",
  "x-decision-versions": ["DEC-002@0.1.0", "DEC-006@0.1.0"],
  "type": "object",
  "required": ["meta", "data"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "common.schema.json#/$defs/metaBase" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "requestTime", "timeoutSec"],
      "properties": {
        "command": {
          "type": "string",
          "enum": [
            "START", "STOP", "PAUSE", "RESUME", "EMERGENCY_STOP",
            "AGITATOR_FORWARD", "AGITATOR_REVERSE", "AGITATOR_STOP",
            "HEATING_ON", "HEATING_OFF", "SET_TARGET_TEMPERATURE",
            "EXHAUST_ON", "EXHAUST_OFF", "AIR_SUPPLY_ON", "AIR_SUPPLY_OFF",
            "DISCHARGE_START", "DISCHARGE_STOP",
            "REBOOT", "SHUTDOWN", "FACTORY_RESET", "TAKE_SNAPSHOT", "FORCE_SYNC"
          ],
          "description": "V1 命令白名单（22 个，command-catalog.json，CT-04）；meta.id 即 commandId。"
        },
        "requestedBy": { "type": "string", "minLength": 1, "description": "请求发起者；云端以身份上下文为准，不信任客户端声明（ADP-001）。" },
        "requestTime": { "$ref": "common.schema.json#/$defs/utcDateTime" },
        "timeoutSec": { "type": "integer", "minimum": 1 },
        "remarks": { "type": "string" }
      }
    }
  }
}
