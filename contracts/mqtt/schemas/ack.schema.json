{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ack.schema.json",
  "title": "ACK",
  "x-typescript-name": "Ack",
  "x-decision-versions": ["DEC-002@1.0.0", "DEC-013@1.0.0", "DEC-015@1.0.0"],
  "type": "object",
  "required": ["meta", "data"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "common.schema.json#/$defs/metaSeq" },
    "data": {
      "type": "object",
      "required": ["objectType"],
      "additionalProperties": false,
      "properties": {
        "objectType": {
          "type": "string",
          "enum": ["COMMAND", "OTA_TARGET"],
          "description": "DEC-015 判别字段：COMMAND 与 OTA_TARGET 关联字段禁止混用。"
        },
        "commandId": {
          "type": "string",
          "minLength": 1,
          "description": "关联的 Command meta.id，如 CMD-DEV001-6001。"
        },
        "command": {
          "type": "string",
          "enum": [
            "START",
            "STOP",
            "PAUSE",
            "RESUME",
            "EMERGENCY_STOP",
            "AGITATOR_FORWARD",
            "AGITATOR_REVERSE",
            "AGITATOR_STOP",
            "HEATING_ON",
            "HEATING_OFF",
            "SET_TARGET_TEMPERATURE",
            "EXHAUST_ON",
            "EXHAUST_OFF",
            "AIR_SUPPLY_ON",
            "AIR_SUPPLY_OFF",
            "DISCHARGE_START",
            "DISCHARGE_STOP",
            "REBOOT",
            "SHUTDOWN",
            "FACTORY_RESET",
            "TAKE_SNAPSHOT",
            "FORCE_SYNC"
          ],
          "description": "V1 命令白名单（22 个，command-catalog.json，CT-04）。"
        },
        "result": { "type": "string", "enum": ["SUCCESS", "FAILED"] },
        "executeTimeMs": { "type": "integer", "minimum": 0 },
        "otaTargetId": {
          "type": "string",
          "minLength": 1,
          "description": "OTA_TARGET 回执关联的云端 OtaTarget ID。"
        },
        "status": {
          "type": "string",
          "enum": ["DOWNLOADING", "INSTALLING", "SUCCEEDED", "FAILED", "ROLLED_BACK"],
          "description": "DEC-015 冻结的 OTA 多阶段状态。"
        },
        "errorCode": { "type": ["string", "null"] },
        "message": { "type": "string" }
      }
    }
  }
}
