{
  "openapi": "3.1.0",
  "info": {
    "title": "Bio-Nexa CMP Device Deactivate API",
    "version": "0.2.0",
    "description": "BE-SYNC-02 设备退役确认接口（mTLS 认证，设备自身身份）：接收源稿定义的无请求体退役确认，校验 Retired + PENDING_CONFIRMATION 上下文，标记 CONFIRMED 后撤销证书。DEC-014@1.0.0 冻结最长 72 小时确认窗口；窗口内独立 Endpoint Allowlist 只放行 Sync/Deactivate，其他 Device REST、业务 MQTT 和命令均拒绝。确认、管理员强制或超时强制后立即撤证。非退役设备返回 409；审计不包含证书材料。错误与扩展成功响应继承 openapi-base.json（CT-05）。",
    "x-decision-versions": ["PRI-001@1.0.0", "ADP-001@1.0.0", "DEC-014@1.0.0"],
    "x-decision-register-version": "1.25.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [{ "url": "/" }],
  "tags": [
    {
      "name": "device",
      "description": "/api/v1/device/* 设备端 API",
      "x-path-prefix": "/api/v1/device",
      "x-auth": "DeviceMtls"
    }
  ],
  "paths": {
    "/api/v1/device/deactivate": {
      "post": {
        "tags": ["device"],
        "operationId": "confirmDeactivation",
        "summary": "设备确认退役（标记 CONFIRMED 并完成证书停用）",
        "description": "身份即设备（mTLS 客户端证书）；无请求体。退役确认与证书撤销同事务（确认在先、断证在后）；并发/重复确认幂等。",
        "security": [{ "DeviceMtls": [] }],
        "responses": {
          "200": {
            "description": "退役已完成或幂等重放",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeactivationSuccess" }
              }
            }
          },
          "401": {
            "description": "未认证（UNAUTHENTICATED：证书缺失/未登记/非 ACTIVE 且无已完成退役/过期）",
            "content": {
              "application/json": {
                "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "设备不存在（NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "非退役设备（DEVICE_STATE_NOT_ALLOWED）/无待退役记录或并发冲突（CONFLICT）",
            "content": {
              "application/json": {
                "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "服务器内部错误（INTERNAL_ERROR）",
            "content": {
              "application/json": {
                "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DeviceMtls": { "$ref": "openapi-base.json#/components/securitySchemes/DeviceMtls" }
    },
    "schemas": {
      "RevokedCertificateSummary": {
        "type": "object",
        "required": ["certificateId", "fingerprint", "status", "revokedAt"],
        "additionalProperties": false,
        "properties": {
          "certificateId": { "type": "string", "minLength": 1 },
          "fingerprint": { "type": "string", "minLength": 1, "description": "证书指纹摘要（不返回 PEM/私钥/证书包）" },
          "status": { "type": "string", "enum": ["REVOKED"] },
          "revokedAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }
        }
      },
      "RetirementView": {
        "type": "object",
        "required": [
          "retirementId",
          "status",
          "reason",
          "initiatedBy",
          "initiatedAt",
          "confirmedAt",
          "completionMethod",
          "certificateRevokedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "retirementId": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["CONFIRMED"] },
          "reason": { "type": "string", "minLength": 1 },
          "initiatedBy": { "type": "string", "minLength": 1 },
          "initiatedAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" },
          "confirmedAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" },
          "completionMethod": {
            "type": "string",
            "enum": ["DEVICE_CONFIRM", "FORCE_COMPLETE", "UNCONFIRMED_TIMEOUT"],
            "description": "DEVICE_CONFIRM=设备确认；FORCE_COMPLETE=管理员强制完成；UNCONFIRMED_TIMEOUT=DEC-014 72 小时超时完成"
          },
          "certificateRevokedAt": {
            "oneOf": [{ "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }, { "type": "null" }]
          }
        }
      },
      "DeactivationResult": {
        "type": "object",
        "required": ["deviceId", "lifecycleStatus", "retirement", "certificates", "replayed"],
        "additionalProperties": false,
        "properties": {
          "deviceId": { "type": "string", "minLength": 1 },
          "lifecycleStatus": { "type": "string", "enum": ["Retired"] },
          "retirement": { "$ref": "#/components/schemas/RetirementView" },
          "certificates": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RevokedCertificateSummary" }
          },
          "replayed": { "type": "boolean", "description": "幂等重放（重复确认，无新写入）" }
        }
      },
      "DeactivationSuccess": {
        "type": "object",
        "required": ["data", "meta"],
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/DeactivationResult" },
          "meta": { "$ref": "openapi-base.json#/components/schemas/ResponseMeta" }
        }
      }
    }
  }
}
