{
  "openapi": "3.1.0",
  "info": {
    "title": "Bio-Nexa CMP Device Onboarding API",
    "version": "0.3.0",
    "description": "设备首次接入：无预置 Token 的 CSR 申请、管理员线下核验审批、CSR 私钥签名轮询，云端仅签发并返回公钥证书。旧 Token 路径仅供迁移兼容。",
    "x-decision-versions": ["PRI-001@1.0.0", "ADP-001@1.0.0", "DEC-003@1.0.0", "DEC-017@1.0.0", "DEC-025@1.0.0"],
    "x-decision-register-version": "1.34.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "device",
      "description": "设备 Onboarding：CSR 自签名申请与签名轮询",
      "x-path-prefix": "/api/v1/device",
      "x-auth": "CsrProof"
    }
  ],
  "paths": {
    "/api/v1/device/onboarding/request": {
      "post": {
        "tags": ["device"],
        "operationId": "submitOnboardingRequest",
        "summary": "提交设备 Onboarding 申请",
        "description": "设备自生成 RSA-2048 或更强密钥，提交已自签名 CSR 和资料；管理员线下核验后审批。相同序列号和公钥幂等重放；不同公钥返回 409。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CsrOnboardingRequestInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "幂等重放：该设备已存在 PENDING 申请，返回原 request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingRequestResult"
                }
              }
            }
          },
          "201": {
            "description": "申请已创建（PENDING）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingRequestResult"
                }
              }
            }
          },
          "400": {
            "description": "字段非法（VALIDATION_FAILED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "旧版 Token 路径凭据无效（新版 CSR 路径无需 Token）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "序列号不存在于设备库存（NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "设备状态不允许或已有不同 CSR 公钥的待审核申请",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "请求频率超限（RATE_LIMITED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "内部错误（INTERNAL_ERROR，不暴露细节）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/device/onboarding/status": {
      "get": {
        "tags": ["device"],
        "operationId": "getOnboardingStatus",
        "summary": "查询 Onboarding 状态（BE-ONB-03）",
        "description": "使用 requestId 定位申请，以 CSR 对应设备私钥签署方法、路径、requestId、毫秒时间戳和随机数；时间窗五分钟，随机数不可重用。批准后仅下发公钥证书，不下发私钥。旧 Token 轮询仅迁移兼容。",
        "security": [],
        "responses": {
          "200": {
            "description": "当前 Onboarding 状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingStatusResult"
                }
              }
            }
          },
          "400": {
            "description": "参数非法（VALIDATION_FAILED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "CSR 签名无效、时间窗外或随机数重放",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "申请不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "证书已领取或过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "请求频率超限（RATE_LIMITED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "内部错误（INTERNAL_ERROR，不暴露细节）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Onboarding-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unix 毫秒时间戳，与服务器偏差不超过 300 秒"
          },
          {
            "name": "X-Onboarding-Nonce",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22,86}$"
            },
            "description": "每次轮询新生成的 base64url 随机数，至少 16 字节"
          },
          {
            "name": "X-Onboarding-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "RSA-SHA256 PKCS#1 v1.5 签名，Base64 编码；签名原文为 GET\\n/api/v1/device/onboarding/status\\n{requestId}\\n{timestamp}\\n{nonce}"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OnboardingToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "AUTH-02 Onboarding Token（Authorization: Bearer fdp_onb_...）；一次一机、与库存序列号绑定，服务端只存 Hash"
      }
    },
    "schemas": {
      "OnboardingRequestInput": {
        "type": "object",
        "required": ["serialNumber", "model", "hardwareVersion", "manufacturer", "manufactureDate"],
        "additionalProperties": false,
        "properties": {
          "serialNumber": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "设备印刷序列号；管理员依据线下制度核对实物与申请"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "hardwareVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "manufactureDate": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "生产日期（UTC，YYYY-MM-DD），不得晚于当前日期"
          }
        }
      },
      "OnboardingRequestResult": {
        "type": "object",
        "required": ["requestId", "status"],
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "description": "Onboarding 申请唯一 ID"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING"]
          }
        }
      },
      "OnboardingStatusPending": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": ["PENDING"]
          }
        }
      },
      "OnboardingStatusRejected": {
        "type": "object",
        "required": ["status", "reason"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": ["REJECTED"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "OnboardingCertificate": {
        "type": "object",
        "required": ["certificatePem"],
        "additionalProperties": false,
        "description": "新 CSR 流程仅返回公钥证书；旧 Token 流程的 privateKey 为迁移兼容字段",
        "properties": {
          "certificatePem": {
            "type": "string",
            "minLength": 1
          },
          "privateKey": {
            "type": "string",
            "minLength": 1,
            "deprecated": true
          }
        }
      },
      "OnboardingMqtt": {
        "type": "object",
        "required": ["endpoint"],
        "additionalProperties": false,
        "properties": {
          "endpoint": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "OnboardingInitialConfiguration": {
        "type": "object",
        "required": ["heartbeatInterval"],
        "additionalProperties": false,
        "properties": {
          "heartbeatInterval": {
            "type": "integer",
            "enum": [60]
          }
        }
      },
      "OnboardingStatusApproved": {
        "type": "object",
        "required": ["status", "deviceId", "certificate", "mqtt", "configuration"],
        "additionalProperties": false,
        "description": "设备须核对证书公钥与本地私钥匹配；证书一次性领取",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["APPROVED"]
          },
          "deviceId": {
            "type": "string",
            "minLength": 1
          },
          "certificate": {
            "$ref": "#/components/schemas/OnboardingCertificate"
          },
          "mqtt": {
            "$ref": "#/components/schemas/OnboardingMqtt"
          },
          "configuration": {
            "$ref": "#/components/schemas/OnboardingInitialConfiguration"
          }
        }
      },
      "OnboardingStatusResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/OnboardingStatusPending"
          },
          {
            "$ref": "#/components/schemas/OnboardingStatusRejected"
          },
          {
            "$ref": "#/components/schemas/OnboardingStatusApproved"
          }
        ]
      },
      "CsrOnboardingRequestInput": {
        "type": "object",
        "required": ["serialNumber", "model", "hardwareVersion", "manufacturer", "manufactureDate", "csrPem"],
        "additionalProperties": false,
        "properties": {
          "serialNumber": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "description": "设备印刷序列号；管理员依据线下制度核对实物与申请"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "hardwareVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "manufactureDate": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "生产日期（UTC，YYYY-MM-DD），不得晚于当前日期"
          },
          "csrPem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "PEM PKCS#10 CSR，自签名且 RSA 公钥至少 2048 位；私钥不离开设备"
          }
        },
        "description": "无需预置 Token 的 CSR 首次申请"
      }
    }
  }
}
