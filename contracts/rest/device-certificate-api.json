{
  "openapi": "3.1.0",
  "info": {
    "title": "Bio-Nexa CMP Device Certificate API",
    "version": "0.2.0",
    "description": "BE-CERT-01/02 设备证书接口。认证为 Device mTLS；成功响应严格保持 Device-Cloud Communication Design 的顶层字段和日期结构，错误响应继承 openapi-base.json（CT-05）。",
    "x-decision-versions": ["PRI-001@1.0.0", "ADP-001@1.0.0", "DEC-003@1.1.0", "DEC-026@1.0.0"],
    "x-decision-register-version": "1.36.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "device",
      "description": "/api/v1/device/* 设备 mTLS API",
      "x-path-prefix": "/api/v1/device",
      "x-auth": "DeviceMtls"
    }
  ],
  "paths": {
    "/api/v1/device/certificate/status": {
      "get": {
        "tags": ["device"],
        "operationId": "getCertificateStatus",
        "summary": "查询当前设备证书状态（BE-CERT-01）",
        "description": "返回当前 mTLS 身份对应证书的 certificateId、状态（ACTIVE/EXPIRING/EXPIRED/REVOKED）、expiryDate（UTC YYYY-MM-DD）与 daysRemaining（UTC 整日差）。EXPIRING 阈值由部署配置注入（默认 30 天）。不自动轮换、不发送到期告警。",
        "security": [
          {
            "DeviceMtls": []
          }
        ],
        "responses": {
          "200": {
            "description": "证书状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateStatus"
                }
              }
            }
          },
          "401": {
            "description": "证书缺失/未登记/非 ACTIVE/过期（UNAUTHENTICATED，不区分原因）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "当前证书绑定设备无权查询状态（FORBIDDEN）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "内部错误（INTERNAL_ERROR，不暴露细节）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/device/certificate/rotate": {
      "post": {
        "tags": ["device"],
        "operationId": "rotateCertificate",
        "summary": "轮换设备证书（BE-CERT-02）",
        "description": "CSR 签发的新证书与完整 CA chain；新旧证并行最长24小时，新证 MQTT Heartbeat 和 REST Sync 均确认后停用旧证。",
        "security": [
          {
            "DeviceMtls": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateRotateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "一次返回新证书及 CA chain，不返回私钥",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateRotateResult"
                }
              }
            }
          },
          "400": {
            "description": "缺少/非法 currentCertificateId（VALIDATION_FAILED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "证书缺失/未登记/撤销/过期（UNAUTHENTICATED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "currentCertificateId 与 mTLS 身份不符（跨设备/错误声明，FORBIDDEN）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "同旧证书的轮换已在进行中（CONFLICT，DEC-003 重复领取失败关闭）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "内部错误（INTERNAL_ERROR，不暴露细节）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "openapi-base.json#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DeviceMtls": {
        "$ref": "openapi-base.json#/components/securitySchemes/DeviceMtls"
      }
    },
    "schemas": {
      "CertificateRotateInput": {
        "type": "object",
        "required": ["currentCertificateId", "csrPem"],
        "additionalProperties": false,
        "properties": {
          "currentCertificateId": {
            "type": "string",
            "minLength": 1,
            "description": "当前在用（旧）证书 ID；必须等于 mTLS 身份证书"
          },
          "csrPem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "RSA-2048+ PKCS#10 CSR，使用设备新私钥签名；私钥不得上传。"
          }
        }
      },
      "CertificateRotateResult": {
        "type": "object",
        "required": ["certificateId", "certificatePem", "effectiveDate", "expiryDate", "certificateChain"],
        "additionalProperties": false,
        "description": "CSR 签发的新证书与完整 CA chain；新旧证并行最长24小时，新证 MQTT Heartbeat 和 REST Sync 均确认后停用旧证。",
        "properties": {
          "certificateId": {
            "type": "string",
            "minLength": 1
          },
          "certificatePem": {
            "type": "string",
            "minLength": 1
          },
          "effectiveDate": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "源稿定义的新证书生效日期（UTC YYYY-MM-DD）"
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "UTC 到期日"
          },
          "certificateChain": {
            "type": "string",
            "minLength": 1,
            "description": "签发 CA 至根 CA 的 PEM 链，不含叶证书和私钥。"
          }
        }
      },
      "CertificateStatus": {
        "type": "object",
        "required": [
          "certificateId",
          "status",
          "expiryDate",
          "daysRemaining",
          "mqttVerifiedAt",
          "restVerifiedAt",
          "rotationDeadlineAt",
          "rotationConfirmedAt"
        ],
        "additionalProperties": false,
        "description": "证书状态视图；不含 certificatePem/privateKey 等密钥材料",
        "properties": {
          "certificateId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "EXPIRING", "EXPIRED", "REVOKED"]
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "UTC 到期日"
          },
          "daysRemaining": {
            "type": "integer",
            "minimum": 0,
            "description": "UTC 整日剩余天数"
          },
          "mqttVerifiedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "restVerifiedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "rotationDeadlineAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "rotationConfirmedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      }
    }
  }
}
