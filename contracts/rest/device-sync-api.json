{
  "openapi": "3.1.0",
  "info": {
    "title": "Bio-Nexa CMP Unified Device Sync API",
    "version": "0.2.0",
    "description": "BE-SYNC-01 统一设备同步接口（mTLS 认证，设备自身身份）：接收 lastSyncTime，按 Device-Cloud Communication Design 的字段名和嵌套结构返回 Assignment、Device、License、Configuration、Device Users 与 Operational Status 的完整顶层快照。V1 不按 lastSyncTime 或 etag 裁剪必要域。Retired 且退役确认待处理的设备仍可调用 Sync 获取最新状态；生命周期 Endpoint Allowlist 与证书认证分离。错误响应继承 openapi-base.json（CT-05）。",
    "x-decision-versions": [
      "PRI-001@1.0.0",
      "ADP-001@1.0.0",
      "DEC-001@1.0.0",
      "DEC-004@1.0.0",
      "DEC-014@1.0.0",
      "DEC-018@1.0.0"
    ],
    "x-decision-register-version": "1.26.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [{ "url": "/" }],
  "tags": [
    {
      "name": "device",
      "description": "/api/v1/device/* 设备端 API",
      "x-path-prefix": "/api/v1/device",
      "x-auth": "DeviceMtls"
    }
  ],
  "paths": {
    "/api/v1/device/sync": {
      "post": {
        "tags": ["device"],
        "operationId": "syncDevice",
        "summary": "统一设备同步（完整事实源快照）",
        "description": "身份即设备（mTLS 客户端证书，AUTH-03）。请求体封闭：仅 lastSyncTime（首次同步为 null 或可省略请求体）。响应始终为全量快照；etag 为稳定域内容寻址版本（SHA-256），供设备检测配置域变化。",
        "security": [{ "DeviceMtls": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SyncRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "完整事实快照",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeviceSyncSnapshot" }
              }
            }
          },
          "400": {
            "description": "请求体校验失败（VALIDATION_FAILED：未知字段/lastSyncTime 非 UTC 时间戳）",
            "content": {
              "application/json": {
                "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "未认证（UNAUTHENTICATED：证书缺失/未登记/非 ACTIVE/过期）",
            "content": {
              "application/json": {
                "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "生命周期不允许访问（FORBIDDEN）；Retired 且退役确认待处理的设备例外，仅允许 Sync/Deactivate",
            "content": {
              "application/json": {
                "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "服务器内部错误（INTERNAL_ERROR）",
            "content": {
              "application/json": {
                "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DeviceMtls": { "$ref": "openapi-base.json#/components/securitySchemes/DeviceMtls" }
    },
    "schemas": {
      "SyncRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lastSyncTime": {
            "oneOf": [{ "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }, { "type": "null" }],
            "description": "上一次成功同步时点；首次同步为 null（或可省略请求体）"
          }
        }
      },
      "SyncAssignment": {
        "type": "object",
        "required": ["customerId", "customerName", "siteId", "siteName"],
        "additionalProperties": false,
        "description": "源稿 Assignment 结构；授权窗口为兼容扩展字段。",
        "properties": {
          "assignmentId": { "type": "string", "minLength": 1 },
          "customerId": { "type": "string", "minLength": 1 },
          "customerName": { "type": "string", "minLength": 1 },
          "siteId": { "type": "string", "minLength": 1 },
          "siteName": { "type": "string", "minLength": 1 },
          "region": { "type": ["string", "null"] },
          "subregion": { "type": ["string", "null"] },
          "assignedAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" },
          "endedAt": { "oneOf": [{ "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }, { "type": "null" }] }
        }
      },
      "SyncDeviceMetadata": {
        "type": "object",
        "required": ["alias"],
        "additionalProperties": false,
        "description": "源稿示例只要求 alias；其余设备元数据为兼容扩展字段。",
        "properties": {
          "deviceId": { "type": "string", "minLength": 1 },
          "alias": { "type": ["string", "null"], "description": "Device Alias（管理后台可改，经本域下发）" },
          "serialNumber": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "firmwareVersion": { "type": ["string", "null"] }
        }
      },
      "SyncLicense": {
        "type": "object",
        "required": ["licenseId", "status", "validFrom", "validTo", "entitlements", "signature"],
        "additionalProperties": false,
        "description": "源稿 License 结构；设备线协议使用大写状态和 OTA entitlement。",
        "properties": {
          "licenseId": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["NO_LICENSE", "DRAFT", "ISSUED", "ACTIVE", "EXPIRING_SOON", "RENEWED", "EXPIRED", "REVOKED"]
          },
          "validFrom": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "validTo": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "entitlements": {
            "type": "array",
            "items": { "type": "string", "enum": ["REMOTE_CONTROL", "OTA", "ESG_REPORTING"] },
            "description": "启用的 Entitlement 代码"
          },
          "signature": {
            "type": "string",
            "minLength": 1,
            "description": "源稿 License 签名；具体算法与规范化方式仍待冻结。"
          },
          "version": { "type": "integer", "minimum": 1 },
          "effective": { "type": "boolean", "description": "查询时点派生：是否可支撑设备运行" }
        }
      },
      "SyncDeviceUser": {
        "type": "object",
        "required": ["userId", "username", "displayName", "passwordHash", "status"],
        "additionalProperties": false,
        "description": "与源稿 Device User 结构同形。passwordHash 是 DEC-004@1.0.0 冻结的 Argon2id PHC 字符串，不得复用云端用户或 Cognito 密码 Hash。",
        "properties": {
          "userId": { "type": "string", "minLength": 1 },
          "username": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "passwordHash": {
            "type": "string",
            "pattern": "^\\$argon2id\\$v=19\\$m=32768,t=3,p=1\\$[^$]+\\$[^$]+$",
            "description": "设备本地专用 Argon2id PHC 字符串；不是云端账号密码 Hash。"
          },
          "status": { "type": "string", "enum": ["ACTIVE", "DISABLED"] }
        }
      },
      "SyncConfiguration": {
        "type": "object",
        "required": ["heartbeatInterval", "telemetryInterval", "cameraRefreshInterval", "temperatureThreshold"],
        "additionalProperties": false,
        "description": "DEC-018@1.0.0 冻结的 V1 Configuration 四字段完整快照；候选扩展字段不得进入 V1。",
        "properties": {
          "heartbeatInterval": {
            "type": "integer",
            "minimum": 10,
            "maximum": 900,
            "default": 60,
            "description": "Heartbeat 间隔，单位：秒。"
          },
          "telemetryInterval": {
            "type": "integer",
            "minimum": 5,
            "maximum": 3600,
            "default": 30,
            "description": "Telemetry 间隔，单位：秒。"
          },
          "cameraRefreshInterval": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "default": 1,
            "description": "摄像头刷新间隔，单位：分钟。"
          },
          "temperatureThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 120,
            "default": 80,
            "description": "温度阈值，单位：°C。"
          }
        }
      },
      "SyncOperationalStatus": {
        "type": "object",
        "required": ["lifecycleStatus", "operationalStatus", "connectivity", "lastHeartbeatAt", "syncIntervalSeconds"],
        "additionalProperties": false,
        "properties": {
          "lifecycleStatus": {
            "type": "string",
            "enum": [
              "PendingOnboarding",
              "Rejected",
              "OnboardingApproved",
              "Onboarded",
              "Assigned",
              "Licensed",
              "Active",
              "Suspended",
              "Retired"
            ],
            "description": "DOM-01 生命周期；Retired 确认待处理设备可通过本接口取得该状态。"
          },
          "operationalStatus": {
            "oneOf": [
              { "type": "string", "enum": ["Active", "Maintenance", "Suspended", "Retired"] },
              { "type": "null" }
            ],
            "description": "运行状态轴（设备上报值；未上报时按生命周期兜底，无法兜底为 null）"
          },
          "connectivity": { "type": "string", "enum": ["ONLINE", "OFFLINE"], "description": "心跳阈值派生（不写回）" },
          "lastHeartbeatAt": {
            "oneOf": [{ "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }, { "type": "null" }]
          },
          "syncIntervalSeconds": {
            "type": "integer",
            "minimum": 1,
            "description": "设备契约同步节奏：Active=300、Suspended=900；Maintenance 经 DEC-001 行为矩阵注入（冻结值 900）；其余沿用 Active 节奏（暂定）"
          }
        }
      },
      "DeviceSyncSnapshot": {
        "type": "object",
        "required": ["assignment", "device", "license", "deviceUsers", "configuration", "operationalStatus"],
        "additionalProperties": false,
        "description": "与源稿顶层域同形的完整事实源快照（全量，不做增量裁剪；未分配/未许可/无配置域为 null 或空数组）。deviceId/snapshotAt/lastSyncTime/etag 是可选兼容元数据，不包裹 data/meta。",
        "properties": {
          "deviceId": { "type": "string", "minLength": 1 },
          "snapshotAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" },
          "lastSyncTime": {
            "oneOf": [{ "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }, { "type": "null" }],
            "description": "请求回显"
          },
          "etag": {
            "type": "string",
            "minLength": 1,
            "description": "稳定域内容寻址版本（SHA-256 hex）；volatile 域（snapshotAt/connectivity/lastHeartbeatAt）不参与"
          },
          "assignment": { "oneOf": [{ "$ref": "#/components/schemas/SyncAssignment" }, { "type": "null" }] },
          "device": { "$ref": "#/components/schemas/SyncDeviceMetadata" },
          "license": { "oneOf": [{ "$ref": "#/components/schemas/SyncLicense" }, { "type": "null" }] },
          "deviceUsers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SyncDeviceUser" }
          },
          "configuration": { "oneOf": [{ "$ref": "#/components/schemas/SyncConfiguration" }, { "type": "null" }] },
          "operationalStatus": { "$ref": "#/components/schemas/SyncOperationalStatus" }
        }
      }
    }
  }
}
