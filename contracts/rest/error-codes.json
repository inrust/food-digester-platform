    { "code": "IDEMPOTENCY_KEY_REQUIRED", "httpStatus": 400, "description": "写操作缺少 Idempotency-Key" },
    { "code": "UNAUTHENTICATED", "httpStatus": 401, "description": "缺少或非法的身份凭证（JWT/Token/证书）" },
    { "code": "FORBIDDEN", "httpStatus": 403, "description": "身份有效但无权限（含跨 Customer 访问）" },
    { "code": "NOT_FOUND", "httpStatus": 404, "description": "资源不存在或对调用方不可见" },
    { "code": "CONFLICT", "httpStatus": 409, "description": "业务约束冲突（如重复唯一键、非法状态迁移）" },
    { "code": "VERSION_CONFLICT", "httpStatus": 409, "description": "If-Match 版本与当前资源版本不一致" },
    { "code": "IDEMPOTENCY_CONFLICT", "httpStatus": 409, "description": "相同 Idempotency-Key 携带不同请求体" },
    { "code": "DEVICE_STATE_NOT_ALLOWED", "httpStatus": 409, "description": "当前设备状态不允许该操作" },
    { "code": "RATE_LIMITED", "httpStatus": 429, "description": "请求频率超限" },
    { "code": "INTERNAL_ERROR", "httpStatus": 500, "description": "服务端内部错误（对外仅暴露通用信息）" }
