{
  "openapi": "3.1.0",
  "info": {
    "title": "Bio-Nexa CMP Device Media Upload API",
    "version": "0.1.0",
    "description": "BE-MED-01 设备端 Media 上传会话 API（mTLS 认证，AUTH-03 设备自身身份）。POST /api/v1/device/media/upload-sessions：校验 mediaType（CT-03 枚举 IMAGE/VIDEO）、fileName、sizeKb（DEC-024 类型上限）、sizeBytes（精确字节数）、sha256（hex64）与每设备 UTC 自然日配额（DEC-024），返回服务端生成 objectPath（media/{customerId}/{deviceId}/{sessionId}/{fileName}，客户端不得指定 Bucket/Key）的 15 分钟预签名上传 URL；签名绑定精确 Content-Length 与 SHA-256 checksum。设备上传后经 MQTT media Topic 上报元数据，由 Media Handler 校验 Object/大小/Hash 后落库（本文件不含该上行通道）。设备须 Active/Maintenance 且已分配 Customer；Retired 拒绝（DEC-014 仅 Sync 例外）。错误响应继承 openapi-base.json（CT-05）。",
    "x-decision-versions": ["PRI-001@1.0.0", "DEC-005@1.0.0", "DEC-014@1.0.0", "DEC-024@1.0.0"],
    "x-decision-register-version": "1.33.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [{ "url": "/" }],
  "tags": [
    {
      "name": "device",
      "description": "/api/v1/device/* 设备端 API",
      "x-path-prefix": "/api/v1/device",
      "x-auth": "DeviceMtls"
    }
  ],
  "paths": {
    "/api/v1/device/media/upload-sessions": {
      "post": {
        "tags": ["device"],
        "operationId": "createMediaUploadSession",
        "summary": "创建 Media 上传会话：类型/大小/配额校验 → 设备前缀短期预签名上传 URL（201）",
        "security": [{ "DeviceMtls": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MediaUploadSessionCreate" } }
          }
        },
        "responses": {
          "201": {
            "description": "上传会话已签发（ISSUED）",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MediaUploadSessionSuccess" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DeviceMtls": { "$ref": "openapi-base.json#/components/securitySchemes/DeviceMtls" }
    },
    "responses": {
      "BadRequest": {
        "description": "校验失败（VALIDATION_FAILED：未知字段、非对象 body，或 mediaType/fileName/sizeKb/sizeBytes/sha256 非法、不一致或超限）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "Unauthorized": {
        "description": "未认证（证书缺失/未登记/非 ACTIVE/过期）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "Forbidden": {
        "description": "设备生命周期不允许（Retired/Suspended）或未分配 Customer",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "Conflict": {
        "description": "每设备每日上传配额超限（CONFLICT）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "InternalError": {
        "description": "内部错误（不暴露细节）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      }
    },
    "schemas": {
      "MediaUploadSessionCreate": {
        "type": "object",
        "required": ["mediaType", "fileName", "sizeKb", "sizeBytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "mediaType": { "type": "string", "enum": ["IMAGE", "VIDEO"], "description": "CT-03 media.schema.json 枚举" },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$",
            "description": "文件名（仅安全字符；objectPath 组成部分，禁止路径分隔符/穿越）"
          },
          "sizeKb": {
            "type": "integer",
            "minimum": 1,
            "description": "申报大小（ceil KB；DEC-024 冻结上限：IMAGE 10240 / VIDEO 204800）"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "description": "精确字节数；必须满足 ceil(sizeBytes / 1024) = sizeKb，并绑定到预签名 PUT Content-Length"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$",
            "description": "申报的 SHA-256（hex；上传后服务端重算比对）"
          }
        }
      },
      "MediaUploadSessionView": {
        "type": "object",
        "required": [
          "sessionId",
          "mediaType",
          "fileName",
          "sizeKb",
          "sizeBytes",
          "objectPath",
          "uploadUrl",
          "uploadUrlExpiresAt",
          "createdAt"
        ],
        "additionalProperties": false,
        "properties": {
          "sessionId": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "enum": ["IMAGE", "VIDEO"] },
          "fileName": { "type": "string", "minLength": 1 },
          "sizeKb": { "type": "integer", "minimum": 1 },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "objectPath": {
            "type": "string",
            "minLength": 1,
            "description": "服务端生成的对象 Key（media/{customerId}/{deviceId}/{sessionId}/{fileName}）；元数据报文 objectPath 必须与其逐字符相等"
          },
          "uploadUrl": {
            "type": "string",
            "pattern": "^https://",
            "description": "DEC-024 冻结的 15 分钟预签名上传 URL（900s）"
          },
          "uploadUrlExpiresAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" },
          "createdAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }
        }
      },
      "MediaUploadSessionSuccess": {
        "type": "object",
        "required": ["data", "meta"],
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/MediaUploadSessionView" },
          "meta": { "$ref": "openapi-base.json#/components/schemas/ResponseMeta" }
        }
      }
    }
  }
}
