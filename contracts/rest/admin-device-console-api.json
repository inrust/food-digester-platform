{
  "openapi": "3.1.0",
  "info": {
    "title": "Bio-Nexa CMP Admin Device Console API",
    "version": "0.1.0",
    "description": "BE-DEV-05 设备控制台组合查询与活动导出 API（Cognito 认证）。GET /api/v1/admin/devices/{deviceId}/console 组合查询（device:read）：五类传感器部件状态、遥测指标（功耗/湿度/温度/重量/马达电流/O2/CO2/CH4/N2O）、网络质量、固件、耗材投影、最近告警、Contract 摘要、近 7 日 ESG、最新 Media（P2 可选块，无数据稳定 null）。各数据块携带 observedAt/单位/stale；局部缺失不使整个响应失败；连接状态、生命周期、运行状态和授权状态分字段返回（DEC-010 四轴分离）。GET .../activities 按级别（kind 派生：ALARM=告警 severity，EVENT 固定 INFO）与时间筛选设备活动日志；POST .../activities/export（export:create）创建异步 CSV 导出（202 入队，Worker 处理，非数据库不限量同步查询）；GET /api/v1/admin/activity-exports/{exportId} 查询导出状态与短期下载 URL。Customer scope 生效（跨 Customer → 404）并复用 DOM-03 审计。功能边界：不提供实时视频流（DEC-009），不透传 MQTT 原始消息。错误响应继承 openapi-base.json（CT-05）。",
    "x-decision-versions": ["DEC-009@1.0.0", "DEC-010@1.0.0"],
    "x-decision-register-version": "1.32.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [{ "url": "/" }],
  "tags": [
    {
      "name": "admin",
      "description": "/api/v1/admin/* 管理端 API",
      "x-path-prefix": "/api/v1/admin",
      "x-auth": "CognitoJwt"
    }
  ],
  "paths": {
    "/api/v1/admin/devices/{deviceId}/console": {
      "get": {
        "tags": ["admin"],
        "operationId": "getDeviceConsole",
        "summary": "设备控制台组合查询（局部数据缺失返回明确空值/stale，不使整个响应失败）",
        "security": [{ "CognitoJwt": [] }],
        "parameters": [{ "$ref": "#/components/parameters/DeviceId" }],
        "responses": {
          "200": {
            "description": "设备控制台视图",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceConsoleSuccess" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/admin/devices/{deviceId}/activities": {
      "get": {
        "tags": ["admin"],
        "operationId": "listDeviceActivities",
        "summary": "设备活动日志（级别/时间筛选 + 复合键集游标分页，occurredAt 倒序 + id 决胜）",
        "security": [{ "CognitoJwt": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/DeviceId" },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["INFO", "WARNING", "MAJOR", "CRITICAL"] },
            "description": "级别筛选：ALARM 条目取告警 severity；EVENT 条目固定 INFO"
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["EVENT", "ALARM"] }
          },
          { "name": "from", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "活动日志页",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActivityListSuccess" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/admin/devices/{deviceId}/activities/export": {
      "post": {
        "tags": ["admin"],
        "operationId": "createActivityExport",
        "summary": "创建活动日志异步 CSV 导出（冻结筛选快照；202 入队，Worker 异步执行）",
        "security": [{ "CognitoJwt": [] }],
        "parameters": [{ "$ref": "#/components/parameters/DeviceId" }],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActivityExportCreate" } } }
        },
        "responses": {
          "202": {
            "description": "导出任务已入队（PENDING）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActivityExportSuccess" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/admin/activity-exports/{exportId}": {
      "get": {
        "tags": ["admin"],
        "operationId": "getActivityExport",
        "summary": "导出任务状态与短期下载 URL（过期后 downloadUrl 为 null 且 urlExpired=true）",
        "security": [{ "CognitoJwt": [] }],
        "parameters": [
          { "name": "exportId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }
        ],
        "responses": {
          "200": {
            "description": "导出任务视图",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActivityExportSuccess" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CognitoJwt": { "$ref": "openapi-base.json#/components/securitySchemes/CognitoJwt" }
    },
    "parameters": {
      "DeviceId": {
        "name": "deviceId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1 }
      },
      "Cursor": { "$ref": "openapi-base.json#/components/parameters/Cursor" },
      "Limit": { "$ref": "openapi-base.json#/components/parameters/Limit" }
    },
    "responses": {
      "BadRequest": {
        "description": "筛选参数非法（VALIDATION_FAILED）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "Unauthorized": {
        "description": "未认证",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "Forbidden": {
        "description": "无 device:read / export:create 权限",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "NotFound": {
        "description": "设备或导出任务不存在，或跨 Customer（NOT_FOUND）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "InternalError": {
        "description": "内部错误（不暴露细节）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      }
    },
    "schemas": {
      "ObservedBlock": {
        "type": "object",
        "required": ["observedAt", "stale"],
        "properties": {
          "observedAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "数据观测时点（无观测为 null）"
          },
          "stale": {
            "type": "boolean",
            "description": "过期标记：心跳类块 = lastHeartbeatAt 距 generatedAt 超 10 分钟（暂定值，BE-DEV-01 口径）；遥测块 = 最新整点桶早于 generatedAt 2 小时以上"
          }
        }
      },
      "ComponentStatus": {
        "type": "object",
        "required": ["overall", "temperature", "humidity", "weight", "gas"],
        "additionalProperties": false,
        "properties": {
          "overall": { "type": ["string", "null"], "enum": ["NORMAL", "WARNING", "FAILED", null] },
          "temperature": { "type": ["string", "null"], "enum": ["NORMAL", "WARNING", "FAILED", null] },
          "humidity": { "type": ["string", "null"], "enum": ["NORMAL", "WARNING", "FAILED", null] },
          "weight": { "type": ["string", "null"], "enum": ["NORMAL", "WARNING", "FAILED", null] },
          "gas": { "type": ["string", "null"], "enum": ["NORMAL", "WARNING", "FAILED", null] }
        },
        "description": "五类部件（传感器）运行状态：device_latest_state.sensorStatus 五键（未上报为 null）"
      },
      "MetricValue": {
        "type": "object",
        "required": ["avg", "min", "max", "unit"],
        "additionalProperties": false,
        "properties": {
          "avg": { "type": "number", "description": "最新整点桶均值" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "unit": { "type": "string", "enum": ["kg", "%", "°C", "kW", "ppm", "A"] }
        }
      },
      "MetricsBlock": {
        "allOf": [{ "$ref": "#/components/schemas/ObservedBlock" }],
        "type": "object",
        "required": ["observedAt", "stale", "metrics"],
        "properties": {
          "metrics": {
            "type": "object",
            "additionalProperties": { "anyOf": [{ "$ref": "#/components/schemas/MetricValue" }, { "type": "null" }] },
            "description": "遥测指标（键为遥测字段名：powerConsumptionKw/humidityPct/ambientTempC/heatTemperatureC/siloTemperatureC/feedingWeightKg/chamberWeightKg/dischargeWeightKg/currentAmp/o2Pct/co2Ppm/ch4Ppm/n2oPpm）；来源 telemetry_hourly 最新整点桶（乱序遥测不倒退最新值：桶聚合为增量合并）；未上报指标为 null"
          }
        }
      },
      "ConsoleAlarm": {
        "type": "object",
        "required": ["alarmId", "code", "severity", "status", "detectedTime"],
        "additionalProperties": false,
        "properties": {
          "alarmId": { "type": "string" },
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["INFO", "WARNING", "MAJOR", "CRITICAL"] },
          "status": { "type": "string", "enum": ["ACTIVE", "ACKNOWLEDGED", "CLEARED"] },
          "detectedTime": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }
        }
      },
      "ContractBrief": {
        "type": "object",
        "required": ["contractId", "contractNumber", "name", "status", "endAt"],
        "additionalProperties": false,
        "properties": {
          "contractId": { "type": "string" },
          "contractNumber": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "endAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }
        }
      },
      "EsgDay": {
        "type": "object",
        "required": ["summaryDate", "carbonReductionKg", "powerConsumptionKwh", "feedingWeightKg"],
        "additionalProperties": false,
        "properties": {
          "summaryDate": { "type": "string", "format": "date" },
          "carbonReductionKg": { "type": ["number", "null"], "description": "无当日聚合行为 null（部分缺失明确空值）" },
          "powerConsumptionKwh": { "type": ["number", "null"] },
          "feedingWeightKg": { "type": ["number", "null"] }
        }
      },
      "LatestMedia": {
        "type": "object",
        "required": ["mediaId", "mediaType", "captureTime"],
        "additionalProperties": false,
        "properties": {
          "mediaId": { "type": "string" },
          "mediaType": { "type": "string" },
          "captureTime": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }
        },
        "description": "最新一张已授权 Media 元数据（DEC-009：仅最新一张，非实时流；无数据/未启用稳定 null）"
      },
      "DeviceConsoleView": {
        "type": "object",
        "required": [
          "generatedAt",
          "device",
          "components",
          "metrics",
          "network",
          "consumables",
          "recentAlarms",
          "contract",
          "esgLast7Days",
          "latestMedia"
        ],
        "additionalProperties": false,
        "properties": {
          "generatedAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" },
          "device": {
            "type": "object",
            "required": [
              "deviceId",
              "serialNumber",
              "alias",
              "model",
              "lifecycleStatus",
              "operationalStatus",
              "connectivity",
              "licenseStatus",
              "firmwareVersion"
            ],
            "additionalProperties": false,
            "properties": {
              "deviceId": { "type": "string" },
              "serialNumber": { "type": "string" },
              "alias": { "type": ["string", "null"] },
              "model": { "type": "string" },
              "lifecycleStatus": { "type": "string", "description": "生命周期轴（DEC-010 四轴分离）" },
              "operationalStatus": { "type": ["string", "null"], "description": "运行状态轴（设备最近上报）" },
              "connectivity": {
                "type": "string",
                "enum": ["ONLINE", "OFFLINE"],
                "description": "连接状态轴（lastHeartbeatAt ≤ 10 分钟派生，暂定值）"
              },
              "licenseStatus": { "type": ["string", "null"], "description": "授权状态轴" },
              "firmwareVersion": { "type": ["string", "null"], "description": "固件（最近上报优先，回退台账）" }
            }
          },
          "components": {
            "allOf": [{ "$ref": "#/components/schemas/ObservedBlock" }],
            "type": "object",
            "required": ["observedAt", "stale", "status"],
            "properties": { "status": { "$ref": "#/components/schemas/ComponentStatus" } }
          },
          "metrics": { "$ref": "#/components/schemas/MetricsBlock" },
          "network": {
            "allOf": [{ "$ref": "#/components/schemas/ObservedBlock" }],
            "type": "object",
            "required": ["observedAt", "stale", "signalStrength", "networkType", "networkStatus"],
            "properties": {
              "signalStrength": { "type": ["integer", "null"], "description": "连接质量：信号强度" },
              "networkType": { "type": ["string", "null"] },
              "networkStatus": { "type": ["string", "null"] }
            }
          },
          "consumables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["consumableType", "remainingPercent", "stale", "observedAt"],
              "additionalProperties": false,
              "properties": {
                "consumableType": { "type": "string", "enum": ["CARBON_FILTER", "BIO_ADDITIVE"] },
                "remainingPercent": { "type": ["integer", "null"], "description": "null = 未知（DEC-008 云端不臆测）" },
                "stale": { "type": "boolean" },
                "observedAt": { "type": ["string", "null"], "format": "date-time" }
              }
            },
            "description": "耗材投影（无投影行时为空数组）"
          },
          "recentAlarms": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ConsoleAlarm" },
            "description": "最近告警：detectedTime 倒序 + id 决胜，固定 5 条"
          },
          "contract": {
            "anyOf": [{ "$ref": "#/components/schemas/ContractBrief" }, { "type": "null" }],
            "description": "有效 Contract 摘要（ACTIVE 关联；无关联为 null）"
          },
          "esgLast7Days": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EsgDay" },
            "description": "近 7 日 ESG（generatedAt 的 UTC 日历日向前 7 个固定日槽，升序；无聚合行日槽指标为 null）"
          },
          "latestMedia": {
            "anyOf": [{ "$ref": "#/components/schemas/LatestMedia" }, { "type": "null" }],
            "description": "最新 Media（P2 可选块；无数据稳定 null，不阻塞 P1 核心查询）"
          }
        }
      },
      "ActivityItem": {
        "type": "object",
        "required": ["activityId", "kind", "level", "occurredAt", "summary", "detail"],
        "additionalProperties": false,
        "properties": {
          "activityId": { "type": "string" },
          "kind": { "type": "string", "enum": ["EVENT", "ALARM"] },
          "level": {
            "type": "string",
            "enum": ["INFO", "WARNING", "MAJOR", "CRITICAL"],
            "description": "级别：ALARM 取 severity；EVENT 固定 INFO（事件无级别概念）"
          },
          "occurredAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" },
          "summary": { "type": "string", "description": "EVENT=eventType；ALARM=告警 code" },
          "detail": {
            "type": "object",
            "description": "EVENT：{eventType,source,userId,username,remarks}；ALARM：{code,severity,status,message,currentValue,threshold,unit}"
          }
        }
      },
      "ActivityListSuccess": {
        "type": "object",
        "required": ["data", "meta"],
        "additionalProperties": false,
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/ActivityItem" } },
          "meta": { "$ref": "openapi-base.json#/components/schemas/PageMeta" }
        }
      },
      "ActivityExportCreate": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "level": { "type": "string", "enum": ["INFO", "WARNING", "MAJOR", "CRITICAL"] },
          "kind": { "type": "string", "enum": ["EVENT", "ALARM"] },
          "from": { "type": "string", "format": "date-time" },
          "to": { "type": "string", "format": "date-time" }
        },
        "description": "筛选快照（与列表查询同源，导出 CSV 与筛选结果一致）"
      },
      "ActivityExportView": {
        "type": "object",
        "required": [
          "exportId",
          "deviceId",
          "status",
          "filters",
          "rowCount",
          "downloadUrl",
          "urlExpiresAt",
          "urlExpired",
          "error",
          "requestedBy",
          "createdAt",
          "completedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "exportId": { "type": "string" },
          "deviceId": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED"] },
          "filters": { "type": "object" },
          "rowCount": { "type": ["integer", "null"] },
          "downloadUrl": {
            "type": ["string", "null"],
            "description": "COMPLETED 且未过期时为短期 URL（15 分钟，暂定值）"
          },
          "urlExpiresAt": { "type": ["string", "null"], "format": "date-time" },
          "urlExpired": { "type": "boolean" },
          "error": { "type": ["string", "null"] },
          "requestedBy": { "type": "string" },
          "createdAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" },
          "completedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "ActivityExportSuccess": {
        "type": "object",
        "required": ["data", "meta"],
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/ActivityExportView" },
          "meta": { "$ref": "openapi-base.json#/components/schemas/ResponseMeta" }
        }
      },
      "DeviceConsoleSuccess": {
        "type": "object",
        "required": ["data", "meta"],
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/DeviceConsoleView" },
          "meta": { "$ref": "openapi-base.json#/components/schemas/ResponseMeta" }
        }
      }
    }
  }
}
