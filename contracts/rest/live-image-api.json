  "components": {
    "schemas": {
      "LiveLease": {
        "type": "object",
        "additionalProperties": false,
        "required": ["streamId", "leaseExpiresAt", "renewAfterSeconds", "readIntervalMs"],
        "properties": {
          "streamId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "leaseExpiresAt": {
            "$ref": "openapi-base.json#/components/schemas/UtcTimestamp"
          },
          "renewAfterSeconds": {
            "type": "integer",
            "const": 10
          },
          "readIntervalMs": {
            "type": "integer",
            "const": 2000
          }
        }
      },
      "LiveIdle": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "pollIntervalMs"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["IDLE"]
          },
          "pollIntervalMs": {
            "type": "integer",
            "const": 5000
          }
        }
      },
      "LiveActive": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "pollIntervalMs", "streamId", "activeUntil", "uploadIntervalMs", "maxImageBytes"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["ACTIVE"]
          },
          "pollIntervalMs": {
            "type": "integer",
            "const": 5000
          },
          "streamId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "activeUntil": {
            "$ref": "openapi-base.json#/components/schemas/UtcTimestamp"
          },
          "uploadIntervalMs": {
            "type": "integer",
            "const": 2000
          },
          "maxImageBytes": {
            "type": "integer",
            "const": 131072
          }
        }
      },
      "LiveFrameCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["streamId", "frameId", "capturedAt", "mimeType", "imageBase64"],
        "properties": {
          "streamId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "frameId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "capturedAt": {
            "$ref": "openapi-base.json#/components/schemas/UtcTimestamp"
          },
          "mimeType": {
            "type": "string",
            "enum": ["image/jpeg"]
          },
          "imageBase64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 174764,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "contentEncoding": "base64",
            "contentMediaType": "image/jpeg",
            "description": "标准带填充 Base64；服务端须解码校验 JPEG、128KiB、1920px/2073600像素、10秒时效及最多2秒时钟超前。"
          }
        }
      },
      "LiveFrameAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frameId", "receivedAt", "expiresAt", "replayed"],
        "properties": {
          "frameId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "receivedAt": {
            "$ref": "openapi-base.json#/components/schemas/UtcTimestamp"
          },
          "expiresAt": {
            "$ref": "openapi-base.json#/components/schemas/UtcTimestamp"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "LiveReady": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "streamId", "frameId", "capturedAt", "expiresAt", "mimeType", "imageBase64"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["READY"]
          },
          "streamId": {
            "type": "string",
            "format": "uuid",
