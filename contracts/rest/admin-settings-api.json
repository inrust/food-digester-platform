{
  "openapi": "3.1.0",
  "info": {
    "title": "Bio-Nexa CMP Admin Settings API",
    "version": "0.1.0",
    "description": "BE-SET-01 业务设置与字典 API（Cognito 认证；读取 settings:read——PlatformSuperAdmin/Auditor；写入 settings:write——仅 PlatformSuperAdmin）。维护封闭 key 集四项业务设置：alarm.thresholds（业务告警阈值）、command.confirmation（命令二次确认策略参数）、dictionary.displayNames（字典显示名称）、notification.business（业务通知配置）。版本控制：PUT 必须携带当前 version（乐观锁），不匹配 → 409；全部写操作经 DOM-03 审计。技术约束：不得经本 API 改写固定协议枚举（22 命令 / 11 Topic type / 13 Notification type——字典仅允许为已知 code 维护显示名，未知 code → 400）、Topic 或 AWS 运维配置。功能边界：不管理 CloudWatch 告警、资源阈值或 Budget。错误响应继承 openapi-base.json（CT-05）。",
    "x-decision-versions": ["DEC-012@1.0.0"],
    "x-decision-register-version": "1.27.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [{ "url": "/" }],
  "tags": [
    {
      "name": "admin",
      "description": "/api/v1/admin/* 管理端 API",
      "x-path-prefix": "/api/v1/admin",
      "x-auth": "CognitoJwt"
    }
  ],
  "paths": {
    "/api/v1/admin/settings": {
      "get": {
        "tags": ["admin"],
        "operationId": "listSettings",
        "summary": "业务设置列表（封闭 key 集全部条目）",
        "security": [{ "CognitoJwt": [] }],
        "responses": {
          "200": {
            "description": "业务设置列表",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SettingListSuccess" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/admin/settings/{key}": {
      "get": {
        "tags": ["admin"],
        "operationId": "getSetting",
        "summary": "读取单项业务设置（未知 key → 404）",
        "security": [{ "CognitoJwt": [] }],
        "parameters": [{ "$ref": "#/components/parameters/SettingKey" }],
        "responses": {
          "200": {
            "description": "业务设置视图",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SettingSuccess" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "put": {
        "tags": ["admin"],
        "operationId": "updateSetting",
        "summary": "更新业务设置（乐观锁：version 不匹配 → 409；非法配置 → 400；固定枚举防护）",
        "security": [{ "CognitoJwt": [] }],
        "parameters": [{ "$ref": "#/components/parameters/SettingKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SettingUpdate" } } }
        },
        "responses": {
          "200": {
            "description": "更新后的业务设置视图（version 自增）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SettingSuccess" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CognitoJwt": { "$ref": "openapi-base.json#/components/securitySchemes/CognitoJwt" }
    },
    "parameters": {
      "SettingKey": {
        "name": "key",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/SettingKey" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "非法配置（VALIDATION_FAILED：值 Schema 不符或触碰固定协议枚举）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "Unauthorized": {
        "description": "未认证",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "Forbidden": {
        "description": "无 settings:read / settings:write 权限",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "NotFound": {
        "description": "未知设置 key（封闭集之外不可创建）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "Conflict": {
        "description": "并发修改冲突（VERSION_CONFLICT：携带的 version 已过期）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      },
      "InternalError": {
        "description": "内部错误（不暴露细节）",
        "content": {
          "application/json": { "schema": { "$ref": "openapi-base.json#/components/schemas/ErrorResponse" } }
        }
      }
    },
    "schemas": {
      "SettingKey": {
        "type": "string",
        "enum": ["alarm.thresholds", "command.confirmation", "dictionary.displayNames", "notification.business"],
        "description": "封闭 key 集：业务告警阈值 / 命令二次确认策略 / 字典显示名称 / 业务通知配置"
      },
      "SettingView": {
        "type": "object",
        "required": ["key", "value", "version", "updatedBy", "updatedAt"],
        "additionalProperties": false,
        "properties": {
          "key": { "$ref": "#/components/schemas/SettingKey" },
          "value": { "description": "设置值（JSON；各 key 的值 Schema 见实现与测试，非法配置拒绝）" },
          "version": { "type": "integer", "minimum": 1, "description": "乐观锁版本（更新时必须在请求体回传）" },
          "updatedBy": { "type": ["string", "null"] },
          "updatedAt": { "$ref": "openapi-base.json#/components/schemas/UtcTimestamp" }
        }
      },
      "SettingUpdate": {
        "type": "object",
        "required": ["value", "version"],
        "additionalProperties": false,
        "properties": {
          "value": { "description": "新设置值（JSON；经 key 对应的值 Schema 校验）" },
          "version": { "type": "integer", "minimum": 1, "description": "当前版本（乐观锁；不匹配 → 409）" }
        }
      },
      "SettingSuccess": {
        "type": "object",
        "required": ["data", "meta"],
        "additionalProperties": false,
        "properties": {
          "data": { "$ref": "#/components/schemas/SettingView" },
          "meta": { "$ref": "openapi-base.json#/components/schemas/ResponseMeta" }
        }
      },
      "SettingListSuccess": {
        "type": "object",
        "required": ["data", "meta"],
        "additionalProperties": false,
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/SettingView" } },
          "meta": { "$ref": "openapi-base.json#/components/schemas/ResponseMeta" }
        }
      }
    }
  }
}
