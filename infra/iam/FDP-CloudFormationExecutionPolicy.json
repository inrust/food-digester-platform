{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowFDPStackServices",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*",
        "s3:*",
        "ecr:*",
        "ssm:*",
        "ec2:*",
        "lambda:*",
        "apigateway:*",
        "rds:*",
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetRandomPassword",
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:ListSecretVersionIds",
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutResourcePolicy",
        "secretsmanager:DeleteResourcePolicy",
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecret",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource",
        "kms:*",
        "sqs:*",
        "iot:*",
        "cognito-idp:*",
        "events:*",
        "scheduler:*",
        "logs:*",
        "cloudwatch:*",
        "sns:*",
        "codebuild:*",
        "acm:*",
        "amplify:*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowFDPServiceRoleManagement",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:PassRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::065986019555:role/fdp-test-*"
    },
    {
      "Sid": "ManageMigrationRunnerBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::065986019555:policy/FDP-MigrationRunnerBoundary"
    },
    {
      "Sid": "CreateApiGatewayServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::065986019555:role/aws-service-role/ops.apigateway.amazonaws.com/AWSServiceRoleForAPIGateway",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "ops.apigateway.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateRdsServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::065986019555:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "rds.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenySecretReadsAndHumanCredentials",
      "Effect": "Deny",
      "Action": ["iam:CreateUser", "iam:CreateAccessKey", "iam:DeleteRolePermissionsBoundary"],
      "Resource": "*"
    },
    {
      "Sid": "DenyNonDatabaseSecretReads",
      "Effect": "Deny",
      "Action": "secretsmanager:GetSecretValue",
      "NotResource": "arn:aws:secretsmanager:ap-southeast-1:065986019555:secret:fdp-test-rds-credentials-*"
    },
    {
      "Sid": "DenyWrongServiceBoundary",
      "Effect": "Deny",
      "Action": ["iam:CreateRole", "iam:PutRolePermissionsBoundary"],
      "Resource": "arn:aws:iam::065986019555:role/fdp-test-*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": [
            "arn:aws:iam::065986019555:policy/FDP-ServiceBoundary",
            "arn:aws:iam::065986019555:policy/FDP-MigrationRunnerBoundary"
          ]
        }
      }
    }
  ]
}
