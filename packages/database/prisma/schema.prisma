  resultSummary Json?     @map("result_summary")
  startedAt     DateTime? @map("started_at") @db.Timestamptz
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz
  leaseToken    String?   @map("lease_token")
  attemptCount  Int       @default(0) @map("attempt_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz

  @@index([status, leaseUntil])
  @@map("replay_jobs")
}

// ---------- 审计（只追加，业务 API 不修改不删除；由 DB-02/DOM-03 的 Repository 策略强制） ----------

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  actorRole   String?  @map("actor_role")
  customerId  String?  @map("customer_id")
  objectType  String   @map("object_type")
  objectId    String   @map("object_id")
  action      String
  reason      String?
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  ip          String?
  userAgent   String?  @map("user_agent")
  result      String // SUCCESS | FAILURE
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([customerId, createdAt])
  @@index([objectType, objectId])
  @@map("audit_logs")
}
