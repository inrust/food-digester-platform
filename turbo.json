{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "@fdp/contracts#build": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    }
  }
}
